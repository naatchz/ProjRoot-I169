[mysqld]
# --- Informations de base & Sécurité réseau ---
user                    = mysql
pid-file                = /var/run/mysqld/mysqld.pid
socket                  = /var/run/mysqld/mysqld.sock
port                    = 3306
basedir                 = /usr
datadir                 = /var/lib/mysql
tmpdir                  = /tmp

# Désactivation du TCP à distance (accès uniquement via socket Unix local)
# Si WordPress et MySQL sont dans des conteneurs séparés sur le même réseau Docker,
# conservez le port 3306 ouvert mais liez-le à l'interface interne (bind-address = 0.0.0.0).
# Pour couper complètement le TCP/IP distant si non nécessaire :
# skip-networking

# Limite les liaisons réseau aux interfaces locales/interne Docker
bind-address            = 0.0.0.0

# --- Moteur de stockage ---
default-storage-engine  = InnoDB

# --- Encodage et Charset (utf8mb4 pour support complet des émojis/symboles) ---
character-set-server     = utf8mb4
collation-server         = utf8mb4_unicode_ci

# --- Optimisations InnoDB ---
innodb_buffer_pool_size  = 256M
innodb_log_file_size     = 64M
innodb_file_per_table    = 1
innodb_flush_log_at_trx_commit = 2

# --- Client & Utilitaires ---
[client]
default-character-set   = utf8mb4

[mysql]
default-character-set   = utf8mb4